---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import calendarIcon from "../assets/images/calendar-icon.svg";

interface Props {
  image: ImageMetadata | string;
  imageAlt: string;
  title: string;
  description: string;
  cta?: { label: string; href: string };
  date?: string;
  href?: string;
}

const { image, imageAlt, title, description, cta, date, href } = Astro.props;
const isRemoteImage = typeof image === "string";
---

<article
  class="border-gdg-stroke flex w-full max-w-[369px] flex-col rounded-lg border bg-white p-6"
>
  <div class="border-gdg-stroke overflow-hidden rounded-md border">
    {
      isRemoteImage ? (
        <img
          src={image as string}
          alt={imageAlt}
          class="h-32 w-full object-cover"
          loading="lazy"
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={imageAlt}
          class="h-32 w-full object-cover"
          loading="lazy"
        />
      )
    }
  </div>

  <h3
    class="text-gdg-text mt-8 font-sans text-[22px] leading-[1.3] font-semibold"
  >
    {
      href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-gdg-blue transition-colors"
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>

  <p class="font-display text-gdg-text-muted mt-2 text-base leading-normal">
    {description}
  </p>

  {
    cta && (
      <a
        href={cta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-gdg-blue-button mt-6 flex h-12 items-center justify-center rounded-[11px] px-4 py-[11px] text-center font-sans text-base font-bold text-white uppercase transition-opacity hover:opacity-90"
      >
        {cta.label}
      </a>
    )
  }

  {
    !cta && date && (
      <div class="mt-6 flex items-center gap-1">
        <Image src={calendarIcon} alt="" class="h-6 w-6" loading="lazy" />
        <span class="font-display text-gdg-blue text-base font-bold">
          {date}
        </span>
      </div>
    )
  }

  {
    !cta && !date && href && (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="border-gdg-stroke text-gdg-blue hover:bg-gdg-bg-gray mt-6 flex h-12 items-center justify-center rounded-[11px] border px-4 py-[11px] text-center font-sans text-base font-bold transition-colors"
      >
        Ver evento →
      </a>
    )
  }
</article>
